# Copia este archivo como .env y completa los valores reales.
# El archivo .env NO se sube a Git.

# =============================
# Django
# =============================
# Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False

# Hosts permitidos, separados por coma. Sin comodines.
DJANGO_ALLOWED_HOSTS=82.25.79.89,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://82.25.79.89,https://82.25.79.89

# Cookies solo por HTTPS. Dejar en False mientras el sitio siga en http.
DJANGO_COOKIES_SEGURAS=False
DJANGO_SSL_REDIRECT=False
# Activar solo cuando el sitio tenga certificado. Empezar con 3600 y subir.
DJANGO_HSTS_SEGUNDOS=0

# Origenes permitidos para la API. Vacio = ninguno externo.
DJANGO_CORS_ORIGINS=

# =============================
# Base de datos
# =============================
# Poner en True para trabajar en local con SQLite en vez de MySQL.
DJANGO_USAR_SQLITE=False

DB_NOMBRE=calderas_ematel
DB_USUARIO=datasensor_farmacia
DB_PASSWORD=cambiame
DB_HOST=82.25.79.89
DB_PUERTO=3306

# =============================
# Correo (reportes de consumo)
# =============================
# Si EMAIL_HOST queda vacio, los correos se imprimen en consola.
EMAIL_HOST=
EMAIL_PUERTO=587
EMAIL_USUARIO=
EMAIL_PASSWORD=
EMAIL_USAR_TLS=True
EMAIL_REMITENTE=no-reply@ematel.cl
